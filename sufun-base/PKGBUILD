# sufun-base: everything that makes an Arch install "SUFUN".
#  - all SUFUN settings and tools (the files in rootfs/, installed to /)
#  - the package list: packages/desktop.txt + our own packages are dependencies,
#    so installing sufun-base installs the whole desktop
#  - os-release (version shown in Settings), Plymouth boot screen, pacman hooks
# Version = the VERSION file at the top of the repository.
#
# Input files, copied next to this PKGBUILD by build-local-repo.sh:
#   VERSION, HOME_URL, desktop.txt, aur.txt
pkgname=sufun-base
pkgver=$(<VERSION)
pkgrel=1
pkgdesc="SUFUN for the Microsoft Surface Go 3: settings, tools and package list"
arch=(any)
url=$(<HOME_URL)
license=(GPL-3.0-or-later)
install=sufun-base.install

_list() { sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "$1"; }
# aur.txt lines: "<name>" or "<name> build-only" (build-only = not installed)
_ours() { awk '{sub(/#.*/,"")} NF && $2 != "build-only" {print $1}' aur.txt; }
depends=(sufun-keyring $(_list desktop.txt) $(_ours))
# rsvg-convert renders the boot screen text and logo; the fonts are only needed for that.
# The Fluent package provides the colors added to kdeglobals.
makedepends=(librsvg ttf-selawik ttf-dejavu sufun-fluent-theme plasma-desktop)
# /etc files: if you edit one, a SUFUN update writes its new version as .pacnew
backup=($(cd rootfs && find etc -type f | sort))

package() {
  cp -a "$startdir/rootfs/." "$pkgdir/"
  cd "$pkgdir"
  # Files come from Windows/git without reliable permissions: set them here.
  find . -type d -exec chmod 755 {} +
  find . -type f -exec chmod 644 {} +
  chmod 755 usr/bin/* usr/lib/sufun/*

  # Version information (Settings > About this System, fastfetch, ...)
  local build_id; build_id=$(date -u --date="@${SOURCE_DATE_EPOCH:-$(date +%s)}" +%Y-%m-%d)
  sed -e "s|@VERSION@|$pkgver|g" -e "s|@BUILD_ID@|$build_id|g" -e "s|@HOME_URL@|$url|g" \
      usr/share/sufun/os-release.in > usr/share/sufun/os-release
  rm usr/share/sufun/os-release.in
  echo "$pkgver" > usr/share/sufun/VERSION
  sed -i "s|@HOME_URL@|$url|g" etc/xdg/kcm-about-distrorc

  # KDE reads colors from kdeglobals itself, so copy the Fluent [Colors:*] groups in.
  awk '/^\[/ { keep = ($0 ~ /^\[(Colors:|ColorEffects:|WM\])/) } keep' \
    /usr/share/color-schemes/FluentLight.colors >> etc/xdg/kdeglobals

  # Pictures rendered now, so no fonts are needed at boot time.
  # Boot screen: SUFUN logo (120 px), the word SUFUN below it, spinner below that.
  local t=usr/share/plymouth/themes/sufun
  rsvg-convert -w 120 -h 120 "$startdir/art/sufun-logo.svg" -o "$t/logo.png"
  rsvg-convert -h 56  "$startdir/art/sufun-text.svg"  -o "$t/sufun.png"
  rsvg-convert -w 40  "$startdir/art/spinner.svg"     -o "$t/spinner.png"
  # Login splash (ksplash, org.sufun.desktop): the same three pictures, at twice
  # the size shown, because Plasma scales the screen on the Surface.
  t=usr/share/plasma/look-and-feel/org.sufun.desktop/contents/splash/images
  install -d "$t"
  rsvg-convert -w 240 -h 240 "$startdir/art/sufun-logo.svg" -o "$t/logo.png"
  rsvg-convert -h 112 "$startdir/art/sufun-text.svg"  -o "$t/sufun.png"
  rsvg-convert -w 80  "$startdir/art/spinner.svg"     -o "$t/spinner.png"

  # The SUFUN logo as a normal icon ("sufun-logo"): launchers (SUFUN Update,
  # System Update, Install SUFUN), the update password prompt, os-release LOGO.
  # PNGs too, so small sizes don't depend on the SVG renderer.
  local s n sizes=(16 22 24 32 48 64 128 256)
  install -Dm644 "$startdir/art/sufun-logo.svg" usr/share/icons/hicolor/scalable/apps/sufun-logo.svg
  for s in "${sizes[@]}"; do
    install -d "usr/share/icons/hicolor/${s}x${s}/apps"
    rsvg-convert -w "$s" -h "$s" "$startdir/art/sufun-logo.svg" -o "usr/share/icons/hicolor/${s}x${s}/apps/sufun-logo.png"
  done
  # Settings > About this System (kcm-about-distrorc)
  install -d usr/share/pixmaps
  rsvg-convert -w 256 -h 256 "$startdir/art/sufun-logo.svg" -o usr/share/pixmaps/sufun-logo.png
  # Task View button (org.sufun.taskview): Fluent's "window-duplicate" glyph, two
  # windows on top of each other (from Fluent-icon-theme, GPL-3.0; not a Microsoft icon).
  install -Dm644 "$startdir/art/sufun-taskview.svg" usr/share/icons/hicolor/scalable/actions/sufun-taskview.svg

  # Icon theme "SUFUN" = Fluent + the SUFUN logo as the start button.
  # Fluent's start-here icons are the Windows logo (removed in sufun-fluent-icons).
  # Our own small theme sits on top of Fluent ("Inherits"), so Fluent updates can
  # never bring the Windows logo back: every start-here* name comes from here.
  local names=(start-here start-here-kde start-here-kde-plasma
    start-here-symbolic start-here-kde-symbolic start-here-kde-plasma-symbolic)
  local dirs=()
  for s in "${sizes[@]}"; do
    install -d "usr/share/icons/SUFUN/${s}x${s}/places"
    cp "usr/share/icons/hicolor/${s}x${s}/apps/sufun-logo.png" "usr/share/icons/SUFUN/${s}x${s}/places/start-here.png"
    for n in "${names[@]:1}"; do
      ln -s start-here.png "usr/share/icons/SUFUN/${s}x${s}/places/$n.png"
    done
    dirs+=("${s}x${s}/places")
  done
  {
    echo '[Icon Theme]'
    echo 'Name=SUFUN'
    echo 'Comment=Fluent icons with the SUFUN start button'
    echo 'Inherits=Fluent,breeze,hicolor'
    echo "Directories=$(IFS=,; echo "${dirs[*]}")"
    for s in "${sizes[@]}"; do
      printf '\n[%sx%s/places]\nSize=%s\nContext=Places\nType=Threshold\n' "$s" "$s" "$s"
    done
  } > usr/share/icons/SUFUN/index.theme

  # Login screen theme "sufun": the installed Breeze SDDM theme with only the
  # Hibernate button removed (see usr/lib/sufun/make-sddm-theme). Made here from
  # the Breeze of this build's plasma-desktop, and again by a pacman hook after
  # every plasma-desktop update. The build stops if Breeze changed too much.
  install -d usr/share/sddm/themes
  bash usr/lib/sufun/make-sddm-theme /usr/share/sddm/themes/breeze usr/share/sddm/themes/sufun

  # Steam must never start at login, even if "Run Steam when my computer starts"
  # is switched on later: mask the unit Plasma creates for ~/.config/autostart/steam.desktop.
  install -d etc/systemd/user
  ln -s /dev/null "etc/systemd/user/app-steam@autostart.service"

  # Start the keyboard switcher (Fcitx5 <-> on-screen keyboard) in every user's
  # Plasma session (same as "systemctl --global enable").
  install -d etc/systemd/user/graphical-session.target.wants
  ln -s /usr/lib/systemd/user/sufun-input-switch.service     etc/systemd/user/graphical-session.target.wants/sufun-input-switch.service
}
