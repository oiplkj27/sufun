#!/usr/bin/env bash
# Runs once for every user, at their first Plasma login (live USB: every boot,
# because the live user is new each time).
#   1. screen scale 150%
#   2. Win+N for notifications (needs a ~2 s restart of the taskbar)
#   3. user folders in the user's language (Korean: 바탕화면, 문서, 다운로드 ...)
#   4. desktop icons: 휴지통, Firefox, Steam, LibreOffice Writer, 메모장
MARK="${XDG_CONFIG_HOME:-$HOME/.config}/sufun/first-login-done"
[[ -f $MARK ]] && exit 0
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
APPLETS="$CFG/plasma-org.kde.plasma.desktop-appletsrc"
sleep 3   # let KWin finish setting up the screens

# --- 1. Built-in screen at 150% ---
# (Plasma would pick about 160-170% by itself on this 10.5" 1920x1280 panel;
# 150% gives more room and an exact 3x DPI for older apps: X11 apps such as
# Wine use 144 DPI = 1.5 x 96 and stay sharp.)
out=$(kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' \
      | awk '/^Output:/ {print $3}' | grep -m1 -E '^eDP')
[[ -n $out ]] && kscreen-doctor "output.$out.scale.1.5" >/dev/null 2>&1

# --- 2. Win+N for notifications (inside the taskbar tray) ---
# Which tray icons are always visible is set by the layout script. The
# notifications widget inside the tray only exists after Plasma has started,
# and Plasma writes it to the settings file only when the shell quits. So, once:
# wait for the taskbar, stop the shell for ~2 seconds (it saves everything), add
# the shortcut, start the shell again.
# Plasma 6.8 saves the tray's widgets as
#   [Containments][<panel>][Applets][<tray>][Applets][<widget>]
notif_ids() {  # prints "<panel> <tray> <notifications widget>" from the saved layout
  awk -F'[][]' '
    /^\[Containments\]\[[0-9]+\]\[Applets\]\[[0-9]+\]\[Applets\]\[[0-9]+\]$/ { p = $4; t = $8; n = $12; next }
    /^\[/ { p = ""; next }
    p != "" && $0 == "plugin=org.kde.plasma.notifications" { print p, t, n; exit }
  ' "$APPLETS" 2>/dev/null
}
for _ in $(seq 60); do        # the taskbar is saved a few seconds after login
  grep -qx 'plugin=org.kde.plasma.systemtray' "$APPLETS" 2>/dev/null && break; sleep 1
done
sleep 5                        # let the tray finish loading its icons
if systemctl --user -q is-active plasma-plasmashell.service; then
  how=systemd; systemctl --user stop plasma-plasmashell.service
else
  how=manual; kquitapp6 plasmashell >/dev/null 2>&1
fi
for _ in $(seq 20); do pgrep -u "$UID" -x plasmashell >/dev/null || break; sleep 0.5; done
ids=$(notif_ids)
if [[ -n $ids ]]; then
  read -r panel tray notif <<< "$ids"
  kwriteconfig6 --file "$APPLETS" --group Containments --group "$panel" --group Applets \
    --group "$tray" --group Applets --group "$notif" --group Shortcuts --key global "Meta+N"
  echo "sufun-first-login: Win+N set (tray $panel/$tray, notifications $notif, restart: $how)"
else
  echo "sufun-first-login: notifications widget not found; groups:" \
       "$(grep -x -B3 'plugin=org.kde.plasma.notifications' "$APPLETS" 2>/dev/null | grep '^\[' | tr '\n' ' ')"
fi
if [[ $how == systemd ]]; then
  systemctl --user start plasma-plasmashell.service
else
  setsid -f plasmashell >/dev/null 2>&1
fi

# --- 3. User folders (names follow the language: 바탕화면, 문서, 다운로드, 사진 ...) ---
xdg-user-dirs-update >/dev/null 2>&1

# --- 4. Desktop icons, like Windows ---
DESK=$(xdg-user-dir DESKTOP 2>/dev/null)
if [[ -n $DESK && $DESK != "$HOME" ]]; then
  mkdir -p "$DESK"
  sleep 5   # the desktop is ready again after step 2
  # The desktop sorts icons by date (oldest first), so 1 second between files
  # keeps this order: 휴지통, Firefox, Steam, LibreOffice Writer, 메모장
  if [[ ! -e $DESK/trash.desktop ]]; then
    {
      echo '[Desktop Entry]'
      echo 'Type=Link'
      echo 'Name=Trash'
      echo 'Name[ko]=휴지통'
      echo 'Icon=user-trash-full'
      echo 'EmptyIcon=user-trash'
      echo 'URL=trash:/'
    } > "$DESK/trash.desktop"
    sleep 1.1
  fi
  for app in firefox steam libreoffice-writer featherpad; do
    for dir in /usr/local/share/applications /usr/share/applications; do
      src="$dir/$app.desktop"
      if [[ -f $src && ! -e $DESK/$app.desktop ]]; then
        cp "$src" "$DESK/$app.desktop"
        chmod 755 "$DESK/$app.desktop"   # "trusted": opens without a warning
        sleep 1.1
        break
      fi
    done
  done
fi

mkdir -p "$(dirname "$MARK")" && touch "$MARK"
