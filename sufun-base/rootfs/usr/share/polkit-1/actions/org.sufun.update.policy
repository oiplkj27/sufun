<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Lets "pkexec /usr/bin/sufun-update" ask for the admin password with a clear message. -->
<policyconfig>
  <vendor>SUFUN</vendor>
  <action id="org.sufun.update">
    <description>Install a SUFUN update</description>
    <description xml:lang="ko">SUFUN 업데이트 설치</description>
    <message>Installing a SUFUN update requires the administrator password.</message>
    <message xml:lang="ko">SUFUN 업데이트를 설치하려면 관리자 암호가 필요합니다.</message>
    <icon_name>system-software-update</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/sufun-update</annotate>
  </action>
</policyconfig>
