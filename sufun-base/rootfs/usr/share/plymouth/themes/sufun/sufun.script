// SUFUN boot screen, on black, top to bottom: the SUFUN logo (logo.png, 120 px),
// the word SUFUN in white (sufun.png), a small spinner (spinner.png).
// All three are pre-rendered pictures (made when sufun-base is built), so they
// look the same everywhere and no fonts are needed at boot.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo = Image("logo.png");
text = Image("sufun.png");
spin = Image("spinner.png");
cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

gap = 24;
// Logo and text together are centered on the screen; the spinner hangs below.
top = cy - (logo.GetHeight() + gap + text.GetHeight()) / 2;

logo_sprite = Sprite(logo);
logo_sprite.SetX(cx - logo.GetWidth() / 2);
logo_sprite.SetY(top);

text_y = top + logo.GetHeight() + gap;
text_sprite = Sprite(text);
text_sprite.SetX(cx - text.GetWidth() / 2);
text_sprite.SetY(text_y);

spin_sprite = Sprite();
spin_y = text_y + text.GetHeight() + 2 * gap + spin.GetHeight() / 2;   // center of the spinner
angle = 0;

fun refresh_callback() {
    angle += 0.09;
    img = spin.Rotate(angle);
    spin_sprite.SetImage(img);
    // a rotated picture can change size, so center it again every frame
    spin_sprite.SetX(cx - img.GetWidth() / 2);
    spin_sprite.SetY(spin_y - img.GetHeight() / 2);
}
Plymouth.SetRefreshFunction(refresh_callback);
