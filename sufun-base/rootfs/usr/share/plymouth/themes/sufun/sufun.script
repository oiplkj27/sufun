// SUFUN boot screen. The text is a pre-rendered picture (sufun.png, made when the
// package is built), so it looks the same everywhere and needs no fonts at boot.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo = Image("sufun.png");
spin = Image("spinner.png");
cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

logo_sprite = Sprite(logo);
logo_sprite.SetX(cx - logo.GetWidth() / 2);
logo_sprite.SetY(cy - logo.GetHeight() / 2);

spin_sprite = Sprite();
spin_y = cy + logo.GetHeight() / 2 + spin.GetHeight();
angle = 0;

fun refresh_callback() {
    angle += 0.09;
    img = spin.Rotate(angle);
    spin_sprite.SetImage(img);
    // a rotated picture can change size, so center it again every frame
    spin_sprite.SetX(cx - img.GetWidth() / 2);
    spin_sprite.SetY(spin_y - img.GetHeight() / 2);
}
Plymouth.SetRefreshFunction(refresh_callback);
