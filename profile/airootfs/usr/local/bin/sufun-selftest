#!/usr/bin/env bash
# Automatic boot/install test for the CI virtual machine. Does nothing unless the
# kernel command line contains "sufun.test=...". Results go to the serial port
# (/dev/ttyS0), where the test script on GitHub reads them:
#   sufun.test=live       live USB: wait for the desktop, check the Windows 11-style
#                         layout, measure RAM, report LIVE-DESKTOP-OK
#   sufun.test=install    live USB: run the installer automatically, then power off
#   sufun.test=installed  installed system: check it, show the login screen, then
#                         log in automatically (test only) to check the Korean
#                         desktop, report results, power off
#   sufun.test=sdinstall  live system on the microSD card: "SD카드에 설치" automatically
#   sufun.test=winsetup   started from the Windows restore test partition: report, power off
#   (installed, 2nd start with /var/lib/sufun-test/restore-phase: Windows restore cleanup test)
MODE=$(sed -n 's/.*sufun\.test=\([a-z]*\).*/\1/p' /proc/cmdline)
# Tool output in English, whatever language the first-start chooser picked
export LC_ALL=C.UTF-8
[[ -n $MODE ]] || exit 0
# The test mode exists only in the CI virtual machine: on a real computer this
# script does nothing, whatever the kernel command line says (security audit T-1).
[[ $(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) == QEMU ]] || exit 0
say() { echo "SUFUN-TEST: $*" > /dev/ttyS0; echo "SUFUN-TEST: $*"; }
# The serial login prompt (agetty) hangs up /dev/ttyS0 when it starts; a program
# still writing to the old ttyS0 then gets write errors and stops. So: wait for
# it, and reopen ttyS0 for every output line (like say()).
wait_serial_getty() {
  local i
  for ((i = 0; i < 120; i += 2)); do systemctl is-active -q serial-getty@ttyS0.service && break; sleep 2; done
  sleep 3
}
to_serial() {  # to_serial <command...>: run it, output line by line to ttyS0; returns its exit code
  "$@" 2>&1 | while IFS= read -r l; do printf '%s\n' "$l" > /dev/ttyS0 2>/dev/null || true; done
  return "${PIPESTATUS[0]}"
}
check() {  # check <name> <command...>
  local name=$1; shift
  if "$@" >/dev/null 2>&1; then say "PASS $name"; else say "FAIL $name"; fi
}
wait_for() {  # wait_for <seconds> <command...>
  local t=$1; shift
  for ((i = 0; i < t; i += 5)); do "$@" >/dev/null 2>&1 && return 0; sleep 5; done
  return 1
}
greeter_up()  { pgrep -f sddm-greeter >/dev/null; }
desktop_up()  { pgrep -u "$1" -x plasmashell >/dev/null && pgrep -x kwin_wayland >/dev/null; }
first_login_done() { test -f "$(getent passwd "$1" | cut -d: -f6)/.config/sufun/first-login-done"; }

# --- Windows 11-style desktop checks (for user $1) ---
check_desktop() {
  local u=$1 home applets desk
  home=$(getent passwd "$u" | cut -d: -f6)
  applets="$home/.config/plasma-org.kde.plasma.desktop-appletsrc"
  desk=$(runuser -u "$u" -- xdg-user-dir DESKTOP 2>/dev/null)
  check taskbar-start-menu   grep -qx 'plugin=org.kde.plasma.kickoff' "$applets"
  check taskbar-search-box   grep -qx 'plugin=org.sufun.search' "$applets"
  check taskbar-task-view    grep -qx 'plugin=org.sufun.taskview' "$applets"
  check taskbar-clock        grep -qx 'plugin=org.sufun.clock' "$applets"
  check tray-always-visible  grep -q '^shownItems=Fcitx,' "$applets"
  check tray-arrow-left      grep -qx 'reverseIconOrder=true' "$applets"
  check shortcut-win-a       grep -qx 'global=Meta+A' "$applets"
  check shortcut-win-n       grep -qx 'global=Meta+N' "$applets"
  check desktop-icons        bash -c "cd '$desk' && test -f trash.desktop -a -x firefox.desktop -a -x steam.desktop -a -x libreoffice-writer.desktop -a -x featherpad.desktop"
  check desktop-columns      grep -qx 'arrangement=1' "$applets"
  check plasma-running       pgrep -u "$u" -x plasmashell
  say "INFO desktop folder: $desk"
  diagnose
}

# --- Things in the image: SUFUN start logo, no Microsoft logos ---
check_image() {
  check start-logo-sufun     test -f /usr/share/icons/SUFUN/48x48/places/start-here-kde.png
  check sufun-logo-icons     test -f /usr/share/icons/hicolor/16x16/apps/sufun-logo.png -a -f /usr/share/icons/hicolor/256x256/apps/sufun-logo.png -a -f /usr/share/pixmaps/sufun-logo.png
  check taskview-icon        test -f /usr/share/icons/hicolor/scalable/actions/sufun-taskview.svg
  # Login splash (ksplash): SUFUN's own theme, never the KDE one
  check ksplash-sufun        bash -c 'grep -qx "Theme=org.sufun.desktop" /etc/xdg/ksplashrc && grep -qx "Engine=KSplashQML" /etc/xdg/ksplashrc'
  check ksplash-files        bash -c 'd=/usr/share/plasma/look-and-feel/org.sufun.desktop/contents/splash; test -f $d/Splash.qml -a -f $d/images/logo.png -a -f $d/images/sufun.png -a -f $d/images/spinner.png'
  # No hibernation with zram: logind must not offer it (Plasma's logout screen and
  # Kickoff then hide the button); normal sleep must not be switched off.
  local hib sus
  hib=$(busctl call org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager CanHibernate 2>/dev/null)
  sus=$(busctl call org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager CanSuspend 2>/dev/null)
  say "INFO logind CanHibernate: ${hib:-?}, CanSuspend: ${sus:-?}"
  check logind-no-hibernate  bash -c '[[ -n $1 && $1 != *yes* && $1 != *challenge* ]]' _ "$hib"
  check suspend-allowed      bash -c '! systemd-analyze cat-config systemd/sleep.conf | grep -Eq "^AllowSuspend=(no|false|0)"'
  # Windows logos were: start-here* in the Fluent icons, icons/start.svg* in the
  # Fluent Plasma style. (Fluent's actions/start.svg is only an arrow, and Breeze's
  # start.svgz is the KDE logo, so those are not counted.)
  local found
  found=$(find /usr/share/icons/Fluent* /usr/share/icons/.Fluent* -iname "start-here*" 2>/dev/null
          find /usr/share/plasma/desktoptheme/Fluent* -path "*/icons/start.svg*" 2>/dev/null)
  found=$(head -n 3 <<< "$found")
  check no-windows-logo      test -z "$found"
  [[ -n $found ]] && say "INFO still there: $(echo $found)"
  check no-microsoft-logos   bash -c '! find /usr/share/icons/Fluent* /usr/share/icons/.Fluent* \( -iname "*microsoft-edge*" -o -iname "ms-word*" -o -iname "*teams*" -o -iname "*ms-excel*" -o -iname "*msoutlook*" \) | grep -q .'
}

# --- RAM numbers (informational, never fail the test) ---
pss_mb() {  # pss_mb <pid...>: memory really used by these processes ("PSS"), in MB
  local p v t=0
  for p in "$@"; do
    v=$(awk '/^Pss:/ {print $2}' "/proc/$p/smaps_rollup" 2>/dev/null)
    t=$((t + ${v:-0}))
  done
  echo $((t / 1024))
}
as_user() {  # as_user <user> <command...>: start a program inside that user's desktop session
  systemd-run --user -M "$1@" --collect --quiet -- "${@:2}"
}
ram_report() {  # ram_report <user>
  local u=$1
  say "INFO ram used-total $(free -m | awk '/^Mem:/ {print $3}') MB of $(free -m | awk '/^Mem:/ {print $2}') MB"
  say "INFO ram plasmashell $(pss_mb $(pgrep -u "$u" -x plasmashell)) MB, kwin_wayland $(pss_mb $(pgrep -x kwin_wayland)) MB"
  # Task manager candidates (Ctrl+Shift+Esc), each measured 25 s after opening.
  # (-f: the kernel cuts process names to 15 letters, "plasma-systemmo")
  as_user "$u" plasma-systemmonitor >/dev/null 2>&1
  sleep 25
  say "INFO ram task-manager plasma-systemmonitor $(pss_mb $(pgrep -u "$u" -f plasma-systemmonitor)) MB + ksystemstats $(pss_mb $(pgrep -u "$u" -x ksystemstats)) MB"
  pkill -u "$u" -f plasma-systemmonitor; sleep 3
  as_user "$u" konsole -e htop >/dev/null 2>&1
  sleep 25
  say "INFO ram task-manager konsole+htop $(pss_mb $(pgrep -u "$u" -x konsole) $(pgrep -u "$u" -x htop)) MB"
  pkill -u "$u" -x konsole; sleep 3
}
# --- Login screen: SDDM must use the SUFUN theme (Breeze without Hibernate) on
# Wayland, not its fallback ---
greeter_check() {
  local cmd logs
  # The SDDM daemon starts the greeter with "--theme <folder>"; with no theme it
  # leaves that out and the greeter uses its built-in fallback screen.
  cmd=$(pgrep -af sddm-greeter | grep -- '--theme' | head -n 1)
  say "INFO greeter: ${cmd:-no greeter with --theme found}"
  # The greeter prints "Loading file:///.../Main.qml..." and, if the theme has
  # an error, the QML errors and "Fallback to embedded theme".
  logs=$( { journalctl -b --no-pager -o cat 2>/dev/null
            cat /var/lib/sddm/.local/share/sddm/*.log 2>/dev/null; } \
          | grep -E 'Loading file:|Fallback to embedded|qrc:/theme|sddm/themes|\.qml:[0-9]+' )
  tail -n 12 <<< "$logs" | while IFS= read -r line; do [[ -n $line ]] && say "LOG greeter: $line"; done
  journalctl -b -u sddm --no-pager -o cat 2>/dev/null | tail -n 8 \
    | while IFS= read -r line; do say "LOG sddm: $line"; done
  check greeter-sufun-theme  bash -c '[[ $1 == *"--theme /usr/share/sddm/themes/sufun"* && $2 != *"Fallback to embedded theme"* ]]' _ "$cmd" "$logs"
  # The theme the greeter really loaded must not contain the Hibernate button:
  # no "hibernate" anywhere in its QML (Breeze's button calls sddm.hibernate()).
  local dir
  dir=$(sed -n 's/.*--theme \([^ ]*\).*/\1/p' <<< "$cmd")
  say "INFO greeter theme folder: ${dir:-?}"
  check greeter-no-hibernate bash -c '[[ -f $1/Main.qml ]] && ! grep -qi hibernate "$1"/*.qml' _ "$dir"
  # ...and apart from that it is the installed Breeze, unchanged: Main.qml only
  # lost lines (nothing added), all other files are identical.
  check greeter-same-as-breeze bash -c 'b=/usr/share/sddm/themes/breeze; ! diff "$b/Main.qml" "$1/Main.qml" | grep -q "^>" && diff -rq -x Main.qml -x metadata.desktop -x SUFUN-README.txt -x theme.conf.user "$b" "$1"' _ "$dir"
  check greeter-wayland      pgrep -u sddm -x kwin_wayland
}

# --- Plasma's logout screen (Ctrl+Alt+Del / power menu): open it for a screenshot.
# It hides Hibernate itself when logind says it isn't available. ---
logout_screen() {  # logout_screen <user>
  local u=$1
  # promptAll = the full screen with every button (sleep, restart, shut down, log out)
  as_user "$u" busctl --user call org.kde.LogoutPrompt /LogoutPrompt org.kde.LogoutPrompt promptAll
  sleep 6
  check logout-screen-open   pgrep -u "$u" -f ksmserver-logout-greeter
  say "SHOT logout"   # the CI script saves 3-installed-logout.png now
  sleep 8
  # Close it without choosing anything (it would act by itself after 30 s).
  pkill -u "$u" -f ksmserver-logout-greeter
  sleep 2
}

# ===================== checks added for the first real-hardware test =====================
uid_of() { id -u "$1"; }
ubus() {  # ubus <user> <command...>: run a command in that user's session (D-Bus, Wayland)
  local u=$1 uid; uid=$(uid_of "$u"); shift
  runuser -u "$u" -- env XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" "$@"
}
expected_lang() {  # the language the first-start chooser was told to pick in this test
  local l; l=$(sed -n 's/.*sufun\.welcome=\([A-Za-z_.0-9-]*\).*/\1/p' /proc/cmdline)
  echo "${l:-ko_KR.UTF-8}"
}

# --- system settings that need no desktop ---
check_system() {
  check zswap-off            bash -c '[[ $(cat /sys/module/zswap/parameters/enabled 2>/dev/null || echo N) == N ]]'
  check sysctl-swappiness    bash -c '[[ $(sysctl -n vm.swappiness) == 180 ]]'
  check sysctl-page-cluster  bash -c '[[ $(sysctl -n vm.page-cluster) == 0 ]]'
  check sysctl-watermark     bash -c '[[ $(sysctl -n vm.watermark_boost_factor) == 0 && $(sysctl -n vm.watermark_scale_factor) == 125 ]]'
  check zram-zstd            bash -c 'grep -q "\[zstd\]" /sys/block/zram0/comp_algorithm'
  check mglru-min-ttl        bash -c '[[ $(cat /sys/kernel/mm/lru_gen/min_ttl_ms) == 1000 ]]'
  check earlyoom             systemctl is-active earlyoom
  check memguard-running     systemctl is-active sufun-memguard
  check kmemwatch-timer      systemctl is-enabled sufun-kmemwatch.timer
  check typecover-service    systemctl is-active sufun-typecover
  check typecover-udev-rule  test -f /usr/lib/udev/rules.d/70-sufun-surface-go3.rules
  check typecover-polkit     test -f /usr/share/polkit-1/rules.d/50-sufun-typecover.rules
  check camera-wireplumber   test -f /etc/wireplumber/wireplumber.conf.d/51-sufun-ipu3-cameras.conf
  check camera-tuning        grep -q relativeLuminanceTarget /etc/libcamera/ipa/ipu3/ov5693.yaml
  local missing="" l
  for l in $(awk -F'\t' '!/^#/ && NF {print $1}' /usr/share/sufun/languages.tsv); do
    locale -a 2>/dev/null | grep -qix "${l%.UTF-8}.utf8" || missing+=" $l"
  done
  say "INFO locales missing:${missing:- none}"
  check locales-generated    test -z "$missing"
  say "INFO zswap $(cat /sys/module/zswap/parameters/enabled 2>/dev/null), swappiness $(sysctl -n vm.swappiness), zram $(cat /sys/block/zram0/comp_algorithm 2>/dev/null)"
}

# --- first-start chooser (language, time zone, keyboard) ---
welcome_shot() {  # screenshot of the chooser while it is shown (CI accepts it after 15 s)
  local i
  for ((i = 0; i < 90; i++)); do
    if pgrep -u sufun-oobe -f 'welcome/Main.qml' >/dev/null 2>&1; then
      sleep 6; say "SHOT welcome"; return 0
    fi
    sleep 1
  done
  say "INFO first-start chooser window not seen (already done?)"
}
check_welcome() {  # check_welcome <user>
  local u=$1 want tz kb pid env
  want=$(expected_lang)
  tz=$(awk -F'\t' -v l="$want" '$1 == l {print $3}' /usr/share/sufun/languages.tsv)
  kb=$(awk -F'\t' -v l="$want" '$1 == l {print $4}' /usr/share/sufun/languages.tsv)
  say "INFO welcome.conf: $(tr '\n' ' ' < /etc/sufun/welcome.conf 2>/dev/null)"
  check welcome-done         test -f /var/lib/sufun/welcome-done
  check welcome-language     grep -qx "LANG=$want" /etc/locale.conf
  check welcome-timezone     bash -c '[[ $(readlink -f /etc/localtime) == */zoneinfo/$1 ]]' _ "$tz"
  check welcome-keyboard     grep -qx "KB=$kb" /etc/sufun/welcome.conf
  if [[ $kb == kr ]]; then
    check fcitx5-hangul      grep -qx 'Name=hangul' /etc/xdg/fcitx5/profile
  else
    check fcitx5-layout      grep -qx "Name=keyboard-$(awk -F'\t' -v k="$kb" '$1 == k {print $3}' /usr/share/sufun/keyboards.tsv)" /etc/xdg/fcitx5/profile
  fi
  pid=$(pgrep -u "$u" -x plasmashell | head -n1)
  env=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep '^LANG=')
  say "INFO desktop session $env"
  check desktop-language     test "$env" = "LANG=$want"
}

# --- small desktop settings ---
check_desktop_extras() {  # check_desktop_extras <user>
  local u=$1 home applets sc
  home=$(getent passwd "$u" | cut -d: -f6)
  applets="$home/.config/plasma-org.kde.plasma.desktop-appletsrc"
  check krunner-opens-empty  grep -qx 'RetainPriorSearch=false' /etc/xdg/krunnerrc
  check touchpad-defaults    bash -c 'grep -qx "TapToClick=true" /etc/xdg/kcminputrc && grep -qx "ClickMethod=2" /etc/xdg/kcminputrc && grep -qx "NaturalScroll=true" /etc/xdg/kcminputrc'
  check tray-rotation-lock   grep -qx 'plugin=org.sufun.rotationlock' "$applets"
  check rotation-lock-toggle bash -c 'a=$(runuser -u "$1" -- /usr/lib/sufun/rotation-lock toggle); b=$(runuser -u "$1" -- /usr/lib/sufun/rotation-lock toggle); [[ $a != "$b" ]]' _ "$u"
  check input-switch-running bash -c 'pgrep -u "$1" -f /usr/lib/sufun/input-switch' _ "$u"
  check memwatch-timer       ubus "$u" systemctl --user is-active sufun-memwatch.timer
  check idle-marker-running  ubus "$u" systemctl --user is-active sufun-idle.service
  check no-gmenudbusmenuproxy bash -c '! pgrep -u "$1" -x gmenudbusmenuproxy' _ "$u"
  # Ctrl+Shift+Esc / Ctrl+Esc / Win+Esc = System Monitor (KDE key codes:
  # Ctrl 0x04000000, Shift 0x02000000, Meta 0x10000000, Esc 0x01000000)
  sc=$(ubus "$u" busctl --user call org.kde.kglobalaccel /kglobalaccel org.kde.KGlobalAccel \
         shortcut as 4 org.kde.plasma-systemmonitor.desktop _launch "System Monitor" "System Monitor" 2>/dev/null)
  say "INFO System Monitor shortcuts (key codes): ${sc:-?}"
  check shortcut-ctrl-shift-esc bash -c '[[ " $1 " == *" 117440512 "* ]]' _ "$sc"
  check shortcut-ctrl-esc       bash -c '[[ " $1 " == *" 83886080 "* ]]' _ "$sc"
  sc=$(ubus "$u" busctl --user call org.kde.kglobalaccel /kglobalaccel org.kde.KGlobalAccel \
         shortcut as 4 org.kde.dolphin.desktop _launch Dolphin Dolphin 2>/dev/null)
  check shortcut-win-e          bash -c '[[ " $1 " == *" 268435525 "* ]]' _ "$sc"
}

# --- System Monitor sensors (ksystemstats) ---
check_sensors() {  # check_sensors <user>
  local u=$1 all s
  all=$(ubus "$u" timeout 60 busctl --user --timeout=50 call org.kde.ksystemstats1 /org/kde/ksystemstats1 org.kde.ksystemstats1 allSensors 2>&1)
  say "INFO ksystemstats answer: $(head -c 240 <<< "$all" | tr '\n' ' ')"
  for s in cpu/all/usage memory/physical/used memory/physical/total memory/swap/used; do
    check "sensor-${s//\//-}" grep -qF "\"$s\"" <<< "$all"
  done
  check sensor-network        grep -qE '"network/[^"/]+/download"' <<< "$all"
  say "INFO sensors: $(grep -oE '"(gpu|disk)/[^"]*/(usage|used)"' <<< "$all" | sort -u | head -n 8 | tr '\n' ' ')"
  say "INFO sensors total: $(grep -oE '"[a-z]+/[^"]+"' <<< "$all" | wc -l)"
  local h; for h in /usr/lib/ksystemstats_intel_helper /usr/lib/ksystemstats_xe_helper; do
    [[ -e $h ]] && say "INFO $(getcap "$h" 2>/dev/null || echo "$h: getcap unavailable")"
  done
}

# --- Firefox: uBlock Origin installed + enabled, can be switched off ---
ff_profile() { find "$1/.mozilla/firefox" "$1/.config/mozilla/firefox" -maxdepth 2 -name extensions.json 2>/dev/null | head -n1 | xargs -r dirname; }
ff_ublock_state() {  # prints "active=<true|false> userDisabled=<true|false>"
  local j="$1/extensions.json"
  [[ -f $j ]] || { echo "none"; return; }
  # extensions.json is one long line: take the uBlock object only
  sed 's/{"id":"/\n{"id":"/g' "$j" | grep '^{"id":"uBlock0@raymondhill.net"' \
    | grep -oE '"(active|userDisabled)":(true|false)' | head -n 2 | tr -d '"' | tr ':' '=' | tr '\n' ' '
}
check_firefox() {  # check_firefox <user>
  local u=$1 home prof st i
  home=$(getent passwd "$u" | cut -d: -f6)
  check ublock-xpi-bundled   test -s /usr/share/sufun/firefox/uBlock0@raymondhill.net.xpi
  check ublock-policy-normal grep -q '"installation_mode": "normal_installed"' /etc/firefox/policies/policies.json
  check ublock-not-forced    bash -c '! grep -q force_installed /etc/firefox/policies/policies.json'
  check ublock-korean-list   grep -q '"KOR-1"' /etc/firefox/policies/policies.json
  check firefox-fission-kept bash -c '! grep -q "fission" /etc/firefox/policies/policies.json'
  # First start of Firefox with a fresh profile (offline is fine: the bundled .xpi)
  as_user "$u" firefox --new-window about:blank >/dev/null 2>&1
  for ((i = 0; i < 90; i += 3)); do
    prof=$(ff_profile "$home"); st=$(ff_ublock_state "${prof:-/x}")
    [[ $st == *active=true* ]] && break
    sleep 3
  done
  say "INFO firefox profile ${prof:-?}: uBlock $st"
  check ublock-installed-enabled bash -c '[[ $1 == *active=true* && $1 == *userDisabled=false* ]]' _ "$st"
}
check_firefox_disable() {  # the user can switch uBlock off (what about:addons does), and it stays off
  local u=$1 home prof st i
  home=$(getent passwd "$u" | cut -d: -f6); prof=$(ff_profile "$home")
  [[ -n $prof ]] || { say "FAIL ublock-can-be-disabled (no profile)"; return; }
  pkill -u "$u" -x firefox; for ((i = 0; i < 30; i++)); do pgrep -u "$u" -x firefox >/dev/null || break; sleep 1; done
  sed 's/{"id":"/\n{"id":"/g' "$prof/extensions.json" \
    | sed '/^{"id":"uBlock0@raymondhill.net"/{s/"userDisabled":false/"userDisabled":true/;s/"active":true/"active":false/}' \
    | tr -d '\n' > "$prof/extensions.json.new" && mv "$prof/extensions.json.new" "$prof/extensions.json"
  chown "$u:" "$prof/extensions.json"
  rm -f "$prof/addonStartup.json.lz4"
  as_user "$u" firefox --headless about:blank >/dev/null 2>&1
  sleep 40
  pkill -u "$u" -x firefox; sleep 5
  st=$(ff_ublock_state "$prof")
  say "INFO after switching uBlock off and restarting Firefox: $st"
  check ublock-can-be-disabled bash -c '[[ $1 == *userDisabled=true* ]]' _ "$st"
}

ping_ms() {  # ping_ms <user> <service> <path>: how long a D-Bus "ping" to it takes (ms)
  local a b
  a=${EPOCHREALTIME/[.,]/}
  ubus "$1" timeout 30 busctl --user call "$2" "$3" org.freedesktop.DBus.Peer Ping >/dev/null 2>&1
  b=${EPOCHREALTIME/[.,]/}
  echo $(( (b - a) / 1000 ))
}
# --- memory stall: a Firefox tab eats memory; the desktop must stay responsive
# and the biggest Firefox process must be the one that is closed ---
memory_pressure_test() {  # memory_pressure_test <user>
  local u=$1 hog=/tmp/sufun-hog.html kw ps fx t0 lat max=0 gone=0 who h= hrss=0 bigp bigr p r limit=5000 extra
  cat > "$hog" <<'HTML'
<!doctype html><title>SUFUN memory test</title><body><h1 id=s>0 MB</h1><script>
// Keeps allocating memory that can't be compressed (random bytes), 64 MB at a time.
var keep = [], n = 0;
function more() {
  var a = new Uint8Array(64 * 1024 * 1024);
  for (var o = 0; o < a.length; o += 65536) crypto.getRandomValues(a.subarray(o, o + 65536));
  keep.push(a); n += 64; document.getElementById('s').textContent = n + ' MB';
  setTimeout(more, 500);
}
setTimeout(more, 8000);
</script>
HTML
  chmod 644 "$hog"
  # Running from the (emulated, very slow) SD card every test command itself has
  # to be read from the card again under memory pressure: allow 10 s there.
  [[ $(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null) == /dev/mmcblk* ]] && limit=10000
  kw=$(pgrep -x kwin_wayland | head -n1); ps=$(pgrep -u "$u" -x plasmashell | head -n1)
  fx=$(pgrep -u "$u" -x firefox | head -n1)
  if [[ -z $fx ]]; then as_user "$u" firefox --new-window about:blank >/dev/null 2>&1; sleep 20; fx=$(pgrep -u "$u" -x firefox | head -n1); fi
  local before; before=$(journalctl -b -u sufun-memguard -o cat 2>/dev/null | grep -c 'closing')
  as_user "$u" firefox --new-tab "file://$hog" >/dev/null 2>&1
  t0=$SECONDS
  # Follow the test page's process ("file:// Content") from the start; every second:
  # is it still the biggest Firefox process? how fast do KWin and Plasma answer?
  while (( SECONDS - t0 < 360 )); do
    [[ -z $h ]] && h=$(pgrep -u "$u" -x 'file:// Content' | head -n1)
    if [[ -n $h ]]; then
      # (a closed process may still be listed for a moment as a "zombie": state Z, no memory)
      if kill -0 "$h" 2>/dev/null && ! grep -q '^State:[[:space:]]*Z' "/proc/$h/status" 2>/dev/null; then
        r=$(awk '/^VmRSS:/ {print $2}' "/proc/$h/status" 2>/dev/null)
        if [[ -n $r ]] && (( r > 0 )); then
          hrss=$r bigp=$h bigr=0
          for p in $(pgrep -u "$u" -f -- '-contentproc'); do
            r=$(awk '/^VmRSS:/ {print $2}' "/proc/$p/status" 2>/dev/null)
            (( ${r:-0} > bigr )) && { bigr=${r:-0}; bigp=$p; }
          done
        fi
        (( SECONDS - t0 == 30 )) && say "SHOT memory-test"
      else
        gone=1
      fi
    fi
    lat=$(ping_ms "$u" org.kde.KWin /KWin); (( lat > max )) && max=$lat
    lat=$(ping_ms "$u" org.kde.plasmashell /PlasmaShell); (( lat > max )) && max=$lat
    (( gone )) && break
    sleep 1
  done
  say "SHOT memory-test-after"
  sleep 15    # anything else closed right after it?
  say "INFO memory test: test page pid ${h:-?} ($((hrss / 1024)) MB at the last look; biggest then: pid ${bigp:-?}), closed after $((SECONDS - t0 - 15)) s, slowest desktop answer $max ms (limit $limit)"
  who=$( { journalctl -b -u sufun-memguard -o cat; journalctl -b -u earlyoom -o cat; journalctl -b -k -o cat | grep -i 'killed process'; } 2>/dev/null | grep -E "pid ${h:-x}[ ,)]|process ${h:-x} |\(${h:-x}\)" | tail -n 2 | tr '\n' ' ')
  extra=$(journalctl -b -u sufun-memguard -o cat 2>/dev/null | grep 'closing' | tail -n +$((before + 1)) | grep -v "pid ${h:-x}," | tr '\n' ' ')
  say "INFO memory test: closed by: ${who:-?}"
  [[ -n $extra ]] && say "INFO memory test: other processes closed: $extra"
  check memtest-test-page-closed      test "$gone" = 1
  check memtest-it-was-the-biggest    bash -c '[[ -n $1 && $1 == "$2" ]]' _ "$h" "$bigp"
  check memtest-closed-by-guard       bash -c '[[ -n $1 ]]' _ "$who"
  check memtest-nothing-else-closed   test -z "$extra"
  check memtest-desktop-responsive    bash -c '(( $1 < $2 ))' _ "$max" "$limit"
  check memtest-kwin-untouched        bash -c '[[ $(pgrep -x kwin_wayland | head -n1) == "$1" ]]' _ "$kw"
  check memtest-plasma-untouched      bash -c '[[ $(pgrep -u "$2" -x plasmashell | head -n1) == "$1" ]]' _ "$ps" "$u"
  check memtest-firefox-survives      bash -c 'kill -0 "$1"' _ "$fx"
  pkill -u "$u" -x firefox; sleep 3; rm -f "$hog"
}

# --- sufun-memwatch (leak cleanup) in test mode: fake sizes, fake clock ---
memwatch_test() {  # memwatch_test <user>
  local u=$1 home d mw hogpid newpid kwpid n restarts notices bad peak
  home=$(getent passwd "$u" | cut -d: -f6)
  d=/tmp/sufun-memwatch-test; rm -rf "$d"; mkdir -p "$d/fake" "$d/run" "$d/state" "$d/k"; chown -R "$u:" "$d"
  # a stand-in for a leaking desktop helper: a user service running "sufunmemtest"
  cp /usr/bin/sleep "$d/sufunmemtest"; chmod 755 "$d/sufunmemtest"
  mkdir -p "$home/.config/systemd/user"
  printf '[Service]\nExecStart=%s infinity\n' "$d/sufunmemtest" > "$home/.config/systemd/user/sufun-memtest-hog.service"
  chown -R "$u:" "$home/.config/systemd"
  ubus "$u" systemctl --user daemon-reload
  ubus "$u" systemctl --user start sufun-memtest-hog.service; sleep 2
  hogpid=$(pgrep -u "$u" -x sufunmemtest); kwpid=$(pgrep -x kwin_wayland | head -n1)
  mw() {  # mw <fake now> <fake size kB>
    echo "$2" > "$d/fake/sufunmemtest"; chown "$u:" "$d/fake/sufunmemtest"
    ubus "$u" env SUFUN_MEMWATCH_TEST=1 SUFUN_MEMWATCH_NOW="$1" SUFUN_MEMWATCH_AGE=700 \
      SUFUN_MEMWATCH_FAKE="$d/fake" SUFUN_MEMWATCH_RUN="$d/run" SUFUN_MEMWATCH_PERSIST="$d/state" \
      SUFUN_MEMWATCH_IDLE="$d/idle" SUFUN_MEMWATCH_KFLAG="$d/k/kernel-leak" \
      SUFUN_MEMWATCH_EXTRA=$'sufunmemtest|unit:sufun-memtest-hog.service|100\nkwin_wayland|unit:plasma-kwin_wayland.service|1\nfirefox|unit:none.service|1' \
      /usr/lib/sufun/memwatch >> "$d/log" 2>&1
  }
  local T=1000000
  mw $T 50000                       # baseline 48 MB
  mw $((T + 180)) 300000            # grows to 290 MB, but the user is not away
  check memwatch-waits-for-idle bash -c '[[ $(pgrep -u "$1" -x sufunmemtest) == "$2" ]] && grep -q "waiting: not idle" "$3"' _ "$u" "$hogpid" "$d/log"
  touch "$d/idle"
  mw $((T + 360)) 300000            # away now: restarted
  sleep 2; newpid=$(pgrep -u "$u" -x sufunmemtest)
  check memwatch-restarts-when-idle bash -c '[[ -n $1 && $1 != "$2" ]]' _ "$newpid" "$hogpid"
  check memwatch-never-kwin     bash -c '[[ $(pgrep -x kwin_wayland | head -n1) == "$1" ]] && grep -q "refusing to watch kwin_wayland" "$2"' _ "$kwpid" "$d/log"
  check memwatch-never-firefox  grep -q "refusing to watch firefox" "$d/log"
  # Oscillating around the limit for 10 hours (a run every 3 minutes)
  for ((n = 1; n <= 200; n++)); do
    if (( n % 2 )); then mw $((T + 360 + n * 180)) 40000; else mw $((T + 360 + n * 180)) 300000; fi
  done
  restarts=$(cat "$d/run/sufunmemtest.restarts" 2>/dev/null || echo 0)
  notices=$(grep -c ' restart$' "$d/run/notices.log" 2>/dev/null || echo 0)
  bad=$(awk '$2 == "restart" { if (p && $1 - p < 3600) b++; p = $1 } END { print b + 0 }' "$d/run/notices.log" 2>/dev/null)
  say "INFO memwatch: $restarts restarts, $notices restart notices in 10 h, $bad closer than 1 h"
  check memwatch-max-3-restarts  bash -c '(( $1 <= 3 ))' _ "$restarts"
  check memwatch-notice-hourly   bash -c '(( $1 == 0 && $2 >= 1 ))' _ "$bad" "$notices"
  check memwatch-stops-looping   grep -q "already restarted 3 times this boot" "$d/log"
  # Kernel memory: the root check (fake meminfo) flags a leak; the desktop notice
  # comes once per boot and, after it was closed, not again for 3 days
  printf 'SUnreclaim: 100000 kB\nPercpu: 1000 kB\n' > "$d/k/meminfo"
  SUFUN_KMEMWATCH_MEMINFO="$d/k/meminfo" SUFUN_KMEMWATCH_DIR="$d/k" SUFUN_KMEMWATCH_UPTIME=700 /usr/lib/sufun/kmemwatch
  printf 'SUnreclaim: 900000 kB\nPercpu: 1000 kB\n' > "$d/k/meminfo"
  for n in 1 2; do SUFUN_KMEMWATCH_MEMINFO="$d/k/meminfo" SUFUN_KMEMWATCH_DIR="$d/k" SUFUN_KMEMWATCH_UPTIME=1400 /usr/lib/sufun/kmemwatch; done
  chmod 755 "$d/k"
  check kmemwatch-flags-leak test -s "$d/k/kernel-leak"
  T=2000000
  for ((n = 0; n < 20; n++)); do mw $((T + n * 180)) 40000; done                  # same boot: once
  rm -f "$d/run/kernel-notice-shown"; mw $((T + 86400)) 40000                     # "next boot", 1 day later: quiet
  rm -f "$d/run/kernel-notice-shown"; mw $((T + 4 * 86400)) 40000                 # 4 days later: again
  n=$(grep -c ' kernel$' "$d/run/notices.log" 2>/dev/null || echo 0)
  say "INFO kernel-leak notices: $n (expected 2: first boot, and again after 3 days)"
  check kmem-notice-not-annoying test "$n" = 2
  # The cleanup itself must stay tiny
  peak=$(ubus "$u" systemd-run --user --wait --collect -p MemoryAccounting=yes \
           env SUFUN_MEMWATCH_TEST=1 SUFUN_MEMWATCH_RUN="$d/run" SUFUN_MEMWATCH_PERSIST="$d/state" \
           /usr/lib/sufun/memwatch 2>&1 | sed -n 's/.*Memory peak: *\([0-9.]*\)\([KMG]\).*/\1 \2/p')
  say "INFO memwatch memory peak: ${peak:-?}"
  check memwatch-small bash -c 'read -r v unit <<< "$1"; [[ -n $v ]] && { [[ $unit == K ]] || { [[ $unit == M ]] && (( ${v%.*} < 12 )); }; }' _ "$peak"
  tail -n 8 "$d/log" | while IFS= read -r l; do say "LOG $l"; done
  ubus "$u" systemctl --user stop sufun-memtest-hog.service
  rm -f "$home/.config/systemd/user/sufun-memtest-hog.service"
}

# --- graphical installer: shows its first question, then the test cancels ---
installer_gui_test() {  # installer_gui_test <user>
  local u=$1 i
  as_user "$u" /usr/local/bin/sufun-install-gui --test-cancel >/dev/null 2>&1
  for ((i = 0; i < 90; i++)); do [[ -s /run/sufun-install/q.json ]] && break; sleep 1; done
  sleep 4; say "SHOT installer"
  for ((i = 0; i < 60; i++)); do grep -q 'GUI-CANCELLED' /run/sufun-install/log 2>/dev/null && break; sleep 1; done
  say "INFO installer window: $(head -c 300 /run/sufun-install/q.json 2>/dev/null)"
  check installer-gui-question grep -q 'GUI-QUESTION 1 MODE' /run/sufun-install/log
  check installer-gui-cancel   grep -q 'GUI-CANCELLED' /run/sufun-install/log
}

# --- RAM: what the desktop's "background services" are, and live write space ---
ram_details() {  # ram_details <user>
  local u=$1 p
  say "INFO ram available $(awk '/^MemAvailable:/ {print int($2/1024)}' /proc/meminfo) MB, swap used $(free -m | awk '/^Swap:/ {print $3}') MB"
  for p in $(pgrep -u "$u"); do
    printf '%s %s\n' "$(awk '/^Pss:/ {print int($2/1024)}' "/proc/$p/smaps_rollup" 2>/dev/null || echo 0)" "$(tr -d '\0' < "/proc/$p/comm" 2>/dev/null)"
  done | awk '{s[$2] += $1} END {for (n in s) if (s[n] >= 3) print s[n], n}' | sort -nr | head -n 25 \
    | while read -r mb name; do say "INFO ram user-process $name $mb MB"; done
  if [[ -d /run/archiso/cowspace ]]; then
    say "INFO live write space (cowspace) used: $(du -sm /run/archiso/cowspace 2>/dev/null | cut -f1) MB of $(df -m --output=size /run/archiso/cowspace | tail -n1 | tr -d ' ') MB"
    du -xm -d 4 /run/archiso/cowspace 2>/dev/null | sort -nr | sed -n '2,9p' | while read -r mb path; do say "INFO cowspace $mb MB ${path#/run/archiso/cowspace}"; done
  fi
}

# If something went wrong: first-login's messages and widget errors, to the serial log
diagnose() {
  journalctl -b --no-pager -o cat 2>/dev/null \
    | grep -E 'sufun-first-login|org\.sufun\.|first-login' | tail -n 15 \
    | while IFS= read -r line; do say "LOG $line"; done
}

# --- microSD install (SUFUN on the card, boot stage on the internal disk) ---
sd_checks() {
  local root rdisk efisrc
  root=$(findmnt -no SOURCE / | sed 's/\[.*//')
  rdisk=$(lsblk -no PKNAME "$root" | head -n1)
  efisrc=$(findmnt -no SOURCE /efi 2>/dev/null)
  say "INFO root on $root, boot stage $efisrc"
  check sd-root-on-card     bash -c '[[ $1 == mmcblk* && $(cat /sys/block/$1/device/type) == SD ]]' _ "$rdisk"
  check sd-boot-stage-internal bash -c '[[ -n $1 && $(lsblk -no PKNAME "$1") != mmcblk* ]]' _ "$efisrc"
  check sd-boot-entry       grep -q '^title *SUFUN (microSD)$' /efi/loader/entries/sufun-sd.conf
  check sd-boot-default     grep -qx 'default sufun-sd.conf' /efi/loader/loader.conf
  check sd-live-entry-kept  test -f /efi/loader/entries/sufun-live.conf
  check sd-live-files-kept  bash -c 'p=$(lsblk -pnlo NAME,TYPE /dev/$1 | awk "\$2==\"part\"{print \$1; exit}"); m=$(mktemp -d); mount -o ro "$p" "$m" && test -f "$m/arch/x86_64/airootfs.sfs"; r=$?; umount "$m"; exit $r' _ "$rdisk"
  check sd-no-bootctl       bash -c '! efibootmgr | grep -q "Linux Boot Manager"'
  check sd-modules-conf     grep -q rtsx_pci_sdmmc /etc/mkinitcpio.conf.d/20-sufun-sd.conf
  check sd-initramfs-rtsx   bash -c 'lsinitcpio /boot/initramfs-linux-surface.img | grep -q rtsx_pci_sdmmc'
  in_sync() { cmp -s /boot/vmlinuz-linux-surface /efi/EFI/SUFUN/sd/vmlinuz-linux-surface \
           && cmp -s /boot/initramfs-linux-surface.img /efi/EFI/SUFUN/sd/initramfs-linux-surface.img; }
  check sd-boot-stage-in-sync in_sync
  # "mkinitcpio -P" by hand: the post hook copies the new initramfs
  echo broken > /efi/EFI/SUFUN/sd/initramfs-linux-surface.img
  mkinitcpio -P >/dev/null 2>&1
  check sd-sync-after-mkinitcpio in_sync
  # Kernel update (reinstall from the package cache): the pacman hook copies it
  echo broken > /efi/EFI/SUFUN/sd/vmlinuz-linux-surface
  local pkg; pkg=$(ls /var/cache/pacman/pkg/linux-surface-[0-9]*.pkg.tar.zst 2>/dev/null | tail -n1)
  say "INFO kernel package: ${pkg:-none}"
  if [[ -n $pkg ]]; then
    pacman -U --noconfirm "$pkg" >/dev/null 2>&1
    check sd-sync-after-kernel-update in_sync
  else
    say "FAIL sd-sync-after-kernel-update (no linux-surface package in the cache)"
  fi
}

# --- Windows restore test (no Microsoft files: a dummy ISO with the same layout) ---
#  phase 1 (installed system, this boot): prepare partition + "Windows Setup" entry,
#           BootNext = that entry, power off
#  phase 2 (next start, sufun.test=winsetup): the firmware started the dummy ISO's
#           boot file from the WININSTALL partition -> WINSETUP-BOOT-OK
#  phase 3 (start after that, installed system): --remove, everything back
# ===================== security audit regression tests (docs/security-audit.md) =====================
# The VM attacks itself (and the CI host scans it); every attack must fail.
SEC_HOST=10.77.0.1 SEC_ME=10.77.0.2 SEC_MAC=52:54:00:77:00:02

# expect <check-name> <ok|refused> <text that must be in the output> <command...>
# "refused" = the command must fail AND say why (so a refusal for the wrong reason is a FAIL).
expect() {
  local name=$1 want=$2 needle=$3 out rc; shift 3
  out=$("$@" 2>&1 </dev/null); rc=$?
  if { [[ $want == ok && $rc -eq 0 ]] || [[ $want == refused && $rc -ne 0 ]]; } && [[ $out == *"$needle"* ]]; then
    say "PASS $name"
  else
    say "FAIL $name (exit $rc, wanted $want with '$needle': $(tail -n 2 <<< "$out" | tr '\n' ' ' | cut -c1-220))"
  fi
}

# --- port scan from the CI host (qemu-test.sh attaches a second network card for it) ---
host_portscan() {
  local ifc= i res=
  for i in /sys/class/net/*; do [[ $(cat "$i/address" 2>/dev/null) == "$SEC_MAC" ]] && ifc=${i##*/}; done
  say "INFO listening sockets (ss -tuln): $(ss -Htuln 2>/dev/null | awk '{print $1 "/" $5}' | sort -u | tr '\n' ' ')"
  # Nothing may listen for TCP connections from the network (loopback only is fine)
  check no-tcp-listener-on-network bash -c '! ss -Htln | awk "{print \$4}" | grep -vE "^(127\.|\[::1\]|\[::ffff:127\.)"'
  [[ -n $ifc ]] || { say "INFO portscan: no scan network card in this test"; return 0; }
  for ((i = 0; i < 40; i++)); do ip -4 addr show dev "$ifc" | grep -q "inet $SEC_ME/" && break; sleep 1; done
  if ! ip -4 addr show dev "$ifc" | grep -q "inet $SEC_ME/"; then
    nmcli device set "$ifc" managed no >/dev/null 2>&1
    ip link set "$ifc" up; ip addr add "$SEC_ME/24" dev "$ifc"
    say "INFO portscan: no DHCP address on $ifc, set $SEC_ME by hand"
  fi
  say "PORTSCAN-READY $SEC_ME"        # the host starts nmap now and then serves its result
  for ((i = 0; i < 120; i++)); do
    res=$(curl -fsS --max-time 3 "http://$SEC_HOST:8099/result" 2>/dev/null) && break
    sleep 3
  done
  say "INFO portscan from the host: ${res:-no answer from the host}"
  check portscan-host-reached-vm   bash -c '[[ $1 == *"REACHED=1 "* ]]' _ "$res"
  check portscan-no-open-tcp-port  bash -c '[[ $1 == *"OPEN_TCP=0 "* ]]' _ "$res"
  check portscan-no-open-udp-port  bash -c '[[ $1 == *"OPEN_UDP=0 "* ]]' _ "$res"
}

# --- checks for the live system AND installed systems ---
security_common() {  # security_common <user>
  local u=$1 decoy out
  check cpu-mitigations-on        bash -c '! grep -qw "mitigations=off" /proc/cmdline'
  check firefox-security-untouched bash -c '! grep -qiE "fission|security\.sandbox|xpinstall\.signatures|security\.tls|cert_pinning|DisableSecurityBypass|\"locked\"" /etc/firefox/policies/policies.json'
  check ublock-file-mozilla-signed bash -c 'bsdtar -tf /usr/share/sufun/firefox/uBlock0@raymondhill.net.xpi | grep -qx META-INF/mozilla.rsa && bsdtar -tf /usr/share/sufun/firefox/uBlock0@raymondhill.net.xpi | grep -qx META-INF/cose.sig'
  check no-ssh-server             bash -c '! systemctl is-active -q sshd && ! pgrep -x sshd'
  check firewall-default-deny     bash -c 'ufw status verbose | grep -q "deny (incoming)"'
  # Programs that run as root must not be changeable by a normal user
  out=$(find /usr/lib/sufun /usr/bin/sufun-* /usr/share/sufun /usr/lib/systemd/system/sufun-* /usr/lib/systemd/system-sleep \
          /usr/share/polkit-1/rules.d/50-sufun-typecover.rules /usr/share/libalpm/hooks /usr/local/bin \
          ! -type l \( ! -user root -o -perm /022 \) 2>/dev/null | head -n 5 | tr '\n' ' ')
  if [[ -z $out ]]; then say "PASS root-programs-not-user-writable"; else say "FAIL root-programs-not-user-writable ($out)"; fi
  out=$(find /usr/lib/sufun /usr/share/sufun /usr/local /etc -xdev -type f -perm /6000 2>/dev/null | head -n 5 | tr '\n' ' ')
  if [[ -z $out ]]; then say "PASS no-setuid-file-from-sufun"; else say "FAIL no-setuid-file-from-sufun ($out)"; fi
  local suid; suid=$(find / -xdev -type f -perm /6000 -printf '%u %m %p\n' 2>/dev/null)
  # owner root, and not writable by group or others (last two digits of the mode)
  out=$(awk '$1 != "root" || $2 ~ /[2367].$/ || $2 ~ /[2367]$/ {print $3}' <<< "$suid" | head -n 5 | tr '\n' ' ')
  if [[ -z $out ]]; then say "PASS setuid-files-root-owned"; else say "FAIL setuid-files-root-owned ($out)"; fi
  say "INFO setuid/setgid programs: $(awk '{print $3}' <<< "$suid" | sed 's|.*/||' | sort | tr '\n' ' ')"
  say "INFO kernel hardening: ptrace_scope=$(sysctl -n kernel.yama.ptrace_scope 2>/dev/null) kptr_restrict=$(sysctl -n kernel.kptr_restrict 2>/dev/null) dmesg_restrict=$(sysctl -n kernel.dmesg_restrict 2>/dev/null) unprivileged_bpf_disabled=$(sysctl -n kernel.unprivileged_bpf_disabled 2>/dev/null) protected_symlinks=$(sysctl -n fs.protected_symlinks 2>/dev/null)"
  # The memory guard must not be steered by a process NAME: a normal user's
  # program that calls itself "Web Content" is not a Firefox tab (audit M-1).
  if ! pgrep -u "$u" -x firefox >/dev/null; then
    runuser -u "$u" -- bash -c 'printf "Web Content" > /proc/$$/comm; sleep 20; true' &
    sleep 2
    decoy=$(pgrep -u "$u" -x 'Web Content' | head -n1)
    out=$(/usr/lib/sufun/memguard --pick)
    say "INFO memguard --pick with a fake 'Web Content' process (pid ${decoy:-?}): '${out}'"
    check memguard-ignores-fake-tab bash -c '[[ -n $1 && -z $2 ]]' _ "$decoy" "$out"
    pkill -u "$u" -x 'Web Content'
  fi
  # The first-start chooser's answer is data: links and shell tricks are refused (audit W-1)
  local before made=0; before=$(cat /etc/locale.conf /etc/vconsole.conf 2>/dev/null | sha256sum)
  [[ -d /run/sufun-welcome ]] || { mkdir -p /run/sufun-welcome; made=1; }
  ln -sfn /etc/shadow /run/sufun-welcome/choice
  expect welcome-refuses-link ok "not a plain file" /usr/lib/sufun/welcome-apply
  printf 'LANG=ko_KR.UTF-8;touch${IFS}/run/sufun-pwned TZ=../../etc/shadow KB=$(touch${IFS}/run/sufun-pwned) * LANG=`id`\n' > /run/sufun-welcome/choice
  out=$(/usr/lib/sufun/welcome-apply 2>&1)
  check welcome-refuses-injection bash -c '[[ $1 == *"refused language"* && $1 == *"refused time zone"* && $1 == *"refused keyboard"* && ! -e /run/sufun-pwned ]]' _ "$out"
  check welcome-settings-unchanged bash -c '[[ $(cat /etc/locale.conf /etc/vconsole.conf 2>/dev/null | sha256sum) == "$1" ]]' _ "$before"
  rm -f /run/sufun-welcome/choice
  (( made )) && rmdir /run/sufun-welcome
  return 0
}

# --- live system only ---
security_live() {  # security_live <user>
  # The installer's automatic test mode needs its own kernel option
  # (sufun.test=install/sdinstall); this boot has sufun.test=live, so it must refuse.
  expect installer-test-mode-refused refused "Test mode refused" env SUFUN_AUTO=1 SUFUN_MODE=emmc SUFUN_USER=x SUFUN_PASS=x /usr/local/bin/sufun-install
  security_common "$1"
}

# --- installed system: accounts, passwords, becoming root ---
security_accounts() {   # before the test logs in (no desktop needed)
  check root-account-locked       bash -c '[[ $(passwd -S root | awk "{print \$2}") == L ]]'
  check no-empty-password         bash -c '! awk -F: "\$2 == \"\" {f=1} END {exit !f}" /etc/shadow'
  check no-live-user              bash -c '! id sufun'
  check sudo-always-asks-password bash -c '! grep -rIs NOPASSWD /etc/sudoers /etc/sudoers.d'
  check sddm-no-autologin         bash -c '! grep -rIshE "^User=.+" /etc/sddm.conf /etc/sddm.conf.d /usr/lib/sddm/sddm.conf.d'
  check boot-menu-editor-off      bash -c 'grep -qx "editor no" /boot/loader/loader.conf 2>/dev/null || grep -qx "editor no" /efi/loader/loader.conf'
  check boot-partition-root-only  bash -c '[[ $(stat -c %a /efi 2>/dev/null) == 700 || $(stat -c %a /boot) == 700 ]]'
  check user-not-in-input-group   bash -c '! id -nG tester | grep -qw input'
  check lock-screen-on            bash -c 'grep -qx "Autolock=true" /etc/xdg/kscreenlockerrc && grep -qx "LockOnResume=true" /etc/xdg/kscreenlockerrc'
}
security_installed() {  # security_installed <user>: the user is logged in (active local session)
  local u=$1 p pk
  security_common "$u"
  # As the normal user, without the password: no way to root
  check user-sudo-needs-password   bash -c '! runuser -u "$1" -- sudo -n true' _ "$u"
  check user-pkexec-needs-password bash -c '! runuser -u "$1" -- pkexec --disable-internal-agent /usr/bin/true' _ "$u"
  check user-cannot-start-units    bash -c '! runuser -u "$1" -- systemctl --no-ask-password start sufun-kmemwatch.service' _ "$u"
  check user-cannot-write-system   bash -c '! runuser -u "$1" -- bash -c "touch /etc/x /usr/lib/sufun/x /boot/x /efi/x /var/lib/sufun/x /run/sufun/x" 2>/dev/null; ! ls /etc/x /usr/lib/sufun/x /boot/x /efi/x /var/lib/sufun/x /run/sufun/x 2>/dev/null | grep -q .' _ "$u"
  # polkit: for the logged-in user only ONE thing is allowed without a password
  # (re-probing the Type Cover touchpad); everything else asks.
  p=$(pgrep -u "$u" -x plasmashell | head -n1)
  pk() { pkcheck --action-id "$1" --process "$p" "${@:2}"; }
  if [[ -n $p ]]; then
    check polkit-touchpad-reprobe-allowed  pk org.freedesktop.systemd1.manage-units --detail unit sufun-typecover-rebind.service --detail verb start
    check polkit-other-unit-asks-password  bash -c '! pkcheck --action-id org.freedesktop.systemd1.manage-units --process "$1" --detail unit sufun-kmemwatch.service --detail verb start' _ "$p"
    check polkit-other-verb-asks-password  bash -c '! pkcheck --action-id org.freedesktop.systemd1.manage-units --process "$1" --detail unit sufun-typecover-rebind.service --detail verb stop' _ "$p"
    check polkit-update-asks-password      bash -c '! pkcheck --action-id org.sufun.update --process "$1"' _ "$p"
    check polkit-restore-asks-password     bash -c '! pkcheck --action-id org.sufun.windows-restore --process "$1"' _ "$p"
  else
    say "FAIL polkit-checks (no plasmashell of $u)"
  fi
  update_attack_tests "$u"
}

# --- .sufun update files: tampered, unsigned, old, wrong key (test media made by
#     scripts/ci/make-security-media.sh with a THROWAWAY key; never the real SUFUN key) ---
update_attack_tests() {  # update_attack_tests <user>
  local u=$1 dev m w real cur tfpr afpr f pkg
  dev=$(lsblk -pnro NAME,LABEL | awk '$2 == "SUFUNSEC" {print $1; exit}')
  [[ -n $dev ]] || { say "INFO update attack tests: no test media in this test"; return 0; }
  m=$(mktemp -d); w=$(mktemp -d /var/tmp/sufun-sec.XXXXXX); chmod 755 "$m" "$w"
  mount -o ro "$dev" "$m" || { say "FAIL update-test-media"; return 0; }
  real=$(ls "$m"/*.sufun 2>/dev/null | head -n1)
  [[ -f $real ]] || { say "FAIL update-test-media (no .sufun file)"; umount "$m"; return 0; }
  cur=$(pacman -Q sufun-base | awk '{print $2}' | sed 's/-[0-9]*$//')
  say "INFO update attack tests with $(basename "$real") ($(du -h "$real" | cut -f1)), installed version $cur"

  # 1. With the system's own keyring (test builds: no key at all; releases: the real
  #    SUFUN key) a file signed by ANOTHER key is refused.
  expect update-other-key-refused refused "" sufun-update --check "$real"

  # From here: the throwaway key is "the SUFUN key" (bind mount, this test VM only)
  export GNUPGHOME="$w/gnupg"; mkdir -p "$GNUPGHOME"; chmod 700 "$GNUPGHOME"
  gpg --batch --quiet --import "$m/test-SECRET-throwaway.asc" >/dev/null 2>&1
  tfpr=$(gpg --batch --with-colons --show-keys "$m/test-public.asc" 2>/dev/null | awk -F: '$1=="pub"{w=1} $1=="fpr"&&w{print $10; exit}')
  gpg --batch --passphrase '' --pinentry-mode loopback --quick-gen-key "attacker" ed25519 sign never >/dev/null 2>&1
  afpr=$(gpg --batch --with-colons --list-secret-keys attacker 2>/dev/null | awk -F: '$1=="fpr"{print $10; exit}')
  mkdir "$w/keys"
  gpg --dearmor < "$m/test-public.asc" > "$w/keys/sufun-release.gpg"       # like the sufun-keyring package
  gpg --batch --export "$afpr" >> "$w/keys/sufun-release.gpg"              # attacker's key is KNOWN but not trusted
  echo "$tfpr:4:" > "$w/keys/trusted"
  chmod -R a+rX "$w/keys"
  [[ -n $tfpr && -n $afpr ]] || say "FAIL update-test-keys (trusted '$tfpr', attacker '$afpr')"
  mount --bind "$w/keys" /usr/share/sufun/keys

  local ALL=(manifest notes.ko.txt SHA256SUMS SHA256SUMS.sig packages)
  unpack() { rm -rf "$w/x"; mkdir "$w/x"; tar -xf "$real" -C "$w/x"; }
  pack()   { ( cd "$w/x" && tar --owner=0 --group=0 -cf "$w/$1" "${@:2}" ); }
  resum()  { ( cd "$w/x" && find . -type f ! -name 'SHA256SUMS*' | sed 's|^\./||' | LC_ALL=C sort | xargs sha256sum > SHA256SUMS ); }
  sign()   { gpg --batch --yes --pinentry-mode loopback --passphrase '' -u "$1" --detach-sign --output "$w/x/$2.sig" "$w/x/$2" 2>/dev/null; }
  setver() { sed -i -e "s/^version=.*/version=$1/" -e "s/^min_from=.*/min_from=${2:-}/" "$w/x/manifest"; }
  fakebase() {  # a tiny "sufun-base 99" package signed with key $1
    rm -f "$w"/x/packages/sufun-base-*; rm -rf "$w/p"; mkdir "$w/p"
    printf 'pkgname = sufun-base\npkgbase = sufun-base\npkgver = 99-1\npkgdesc = security test\nurl = https://example.invalid\nbuilddate = 1\npackager = test\nsize = 0\narch = any\n' > "$w/p/.PKGINFO"
    bsdtar -C "$w/p" -cf - .PKGINFO | zstd -q > "$w/x/packages/sufun-base-99-1-any.pkg.tar.zst"
    sign "$1" packages/sufun-base-99-1-any.pkg.tar.zst
  }

  # 2. The real file (made by the release tools) passes signature + checksums ...
  expect update-real-file-verifies      ok "version=$cur" sufun-update --check "$real"
  expect update-user-can-check          ok "version=$cur" runuser -u "$u" -- sufun-update --check "$real"
  # ... but it is the version already installed: replaying an old update is refused
  expect update-old-version-refused     refused "되돌릴 수 없습니다" sufun-update --yes "$real"
  # 3. A normal user can never install, not even a good file
  expect update-user-cannot-install     refused "관리자 권한" runuser -u "$u" -- sufun-update --yes "$real"
  check  update-user-pkexec-needs-password bash -c '! runuser -u "$1" -- pkexec --disable-internal-agent /usr/bin/sufun-update --yes "$2"' _ "$u" "$real"
  # 4. One byte added to a package
  unpack; pkg=$(ls "$w"/x/packages/*.pkg.tar.zst | head -n1); echo x >> "$pkg"; pack tamper-pkg.sufun "${ALL[@]}"
  expect update-tampered-package-refused refused "체크섬" sufun-update --yes "$w/tamper-pkg.sufun"
  # 5. Version number raised without the key
  unpack; setver 99; pack tamper-manifest.sufun "${ALL[@]}"
  expect update-tampered-version-refused refused "체크섬" sufun-update --yes "$w/tamper-manifest.sufun"
  # 6. Everything re-made and signed by the attacker's own key
  unpack; setver 99; fakebase "$afpr"; resum; sign "$afpr" SHA256SUMS; pack attacker.sufun "${ALL[@]}"
  expect update-attacker-key-refused    refused "서명이 올바르지" sufun-update --yes "$w/attacker.sufun"
  # 7. No signature at all
  unpack; setver 99; resum; rm -f "$w/x/SHA256SUMS.sig"; pack unsigned.sufun manifest notes.ko.txt SHA256SUMS packages
  expect update-unsigned-refused        refused "SHA256SUMS.sig" sufun-update --yes "$w/unsigned.sufun"
  # 8. Extra file, link, and a path that tries to leave the folder
  unpack; echo 'touch /run/sufun-pwned' > "$w/x/evil.sh"; pack extra.sufun "${ALL[@]}" evil.sh
  expect update-extra-file-refused      refused "예상하지 못한 파일" sufun-update --yes "$w/extra.sufun"
  unpack; ln -s /etc/shadow "$w/x/packages/zz-link.pkg.tar.zst"; pack link.sufun "${ALL[@]}"
  expect update-link-refused            refused "링크" sufun-update --yes "$w/link.sufun"
  unpack; echo pwned > "$w/x/evil"
  ( cd "$w/x" && tar -P --owner=0 --group=0 --transform 's|^evil$|../../../../../../run/sufun-pwned|' -cf "$w/traversal.sufun" "${ALL[@]}" evil ) 2>/dev/null
  expect update-path-traversal-refused  refused "예상하지 못한 파일" sufun-update --yes "$w/traversal.sufun"
  check  update-nothing-escaped         bash -c '! ls /run/sufun-pwned /var/tmp/sufun-pwned /var/sufun-pwned 2>/dev/null | grep -q .'
  # 9. Good list signature, but one package inside is signed by the attacker
  unpack; pkg=$(ls "$w"/x/packages/*.pkg.tar.zst | head -n1); sign "$afpr" "packages/$(basename "$pkg")"; resum; sign "$tfpr" SHA256SUMS; pack badpkgsig.sufun "${ALL[@]}"
  expect update-package-signature-checked refused "서명이 올바르지" sufun-update --yes "$w/badpkgsig.sufun"
  # 10. Control: a NEWER update signed by the trusted key passes every check and
  #     only then asks (no answer here = cancelled; nothing is installed).
  unpack; setver 99; fakebase "$tfpr"; resum; sign "$tfpr" SHA256SUMS; pack newer.sufun "${ALL[@]}"
  expect update-newer-signed-passes     ok "version=99" sufun-update --check "$w/newer.sufun"
  expect update-newer-asks-first        refused "→ 99" sufun-update "$w/newer.sufun"
  # 11. ...and the "needs at least version X" rule
  unpack; setver 99 50; fakebase "$tfpr"; resum; sign "$tfpr" SHA256SUMS; pack minfrom.sufun "${ALL[@]}"
  expect update-min-version-rule        refused "이상에서만" sufun-update --yes "$w/minfrom.sufun"
  # 12. Option-like and odd file names are not passed on to tar
  expect update-option-name-refused     refused "알 수 없는 옵션" sufun-update --yes --checkpoint-action=exec=id

  check update-still-same-version bash -c '[[ $(pacman -Q sufun-base | awk "{print \$2}" | sed "s/-[0-9]*\$//") == "$1" ]]' _ "$cur"
  check update-no-leftovers       bash -c '! compgen -G "/var/tmp/sufun-update.*" >/dev/null && [[ ! -e /var/lib/pacman/sync/sufun-update.db ]]'
  umount /usr/share/sufun/keys; umount "$m"
  gpgconf --kill all >/dev/null 2>&1; unset GNUPGHOME
  rm -rf "$w" "$m"
}

PHASE=/var/lib/sufun-test/restore-phase
part_sectors() { cat "/sys/class/block/${1#/dev/}/size"; }
restore_prepare() {
  local iso root num first_before first_after
  iso=$(lsblk -pnro NAME,LABEL | awk '$2 == "SUFUN_WINTEST" {print $1; exit}')
  [[ -n $iso ]] || return 0
  root=$(findmnt -no SOURCE / | sed 's/\[.*//')
  say "INFO restore test with $iso, SUFUN root $root ($(part_sectors "$root") sectors)"
  first_before=$(efibootmgr | sed -n 's/^BootOrder: \([0-9A-Fa-f]*\).*/\1/p')
  check restore-not-prepared bash -c '! sufun-windows-restore --status'
  if to_serial env SUFUN_WIM_SPLIT_MB=16 sufun-windows-restore --prepare "$iso" --yes; then
    say "PASS restore-prepare"
  else
    say "FAIL restore-prepare"; return 0
  fi
  local part; part=$(lsblk -pnro NAME,LABEL | awk '$2 == "WININSTALL" {print $1; exit}')
  num=$(sed -n 's/^BOOTNUM=//p' /var/lib/sufun/windows-restore.conf)
  first_after=$(efibootmgr | sed -n 's/^BootOrder: \([0-9A-Fa-f]*\).*/\1/p')
  say "INFO WININSTALL=$part entry=Boot$num, order: $(efibootmgr | sed -n 's/^BootOrder: //p')"
  check restore-partition     test -b "$part"
  check restore-same-disk     bash -c '[[ $(lsblk -no PKNAME "$1") == $(lsblk -no PKNAME "$2") ]]' _ "$part" "$root"
  check restore-root-shrunk   bash -c '(( $(cat /sys/class/block/${1#/dev/}/size) < $2 ))' _ "$root" "$(grep -o '^OLD_ROOT_SECTORS=.*' /var/lib/sufun/windows-restore.conf | cut -d= -f2)"
  check restore-fat32         bash -c '[[ $(lsblk -no FSTYPE "$1") == vfat ]]' _ "$part"
  local m; m=$(mktemp -d); mount -o ro "$part" "$m"
  check restore-boot-file     test -f "$m/efi/boot/bootx64.efi" -a -f "$m/efi/microsoft/boot/bcd" -a -f "$m/sources/boot.wim"
  check restore-wim-split     bash -c 'ls "$1"/sources/install*.swm | wc -l | grep -qv "^[01]$" && ! test -e "$1/sources/install.wim"' _ "$m"
  say "INFO split parts: $(ls "$m"/sources/ | tr '\n' ' ')"
  umount "$m"; rmdir "$m"
  check restore-entry         bash -c 'efibootmgr | grep -q "^Boot$1\*\? Windows Setup"' _ "$num"
  check restore-entry-last    bash -c 'efibootmgr | sed -n "s/^BootOrder: //p" | grep -qiE "(^|,)$1\$"' _ "$num"
  check restore-default-kept  test "$first_before" = "$first_after"
  check restore-status        sufun-windows-restore --status
  # Like the window's "지금 Windows 설치 시작" button, but without rebooting now
  to_serial sufun-windows-restore --reboot-to-setup
  check restore-bootnext      bash -c 'efibootmgr | grep -qi "^BootNext: $1"' _ "$num"
  mkdir -p "${PHASE%/*}"; echo cleanup > "$PHASE"
  say "RESTORE-PREPARED"
}
restore_cleanup() {
  local root old
  root=$(findmnt -no SOURCE / | sed 's/\[.*//')
  old=$(sed -n 's/^OLD_ROOT_SECTORS=//p' /var/lib/sufun/windows-restore.conf)
  say "BOOTED restore-cleanup"
  check restore-bootnext-used bash -c '! efibootmgr | grep -q "^BootNext"'
  if to_serial sufun-windows-restore --remove --yes; then say "PASS restore-remove"; else say "FAIL restore-remove"; fi
  check cleanup-partition-gone bash -c '! lsblk -no LABEL | grep -qx WININSTALL'
  check cleanup-entry-gone     bash -c '! efibootmgr | grep -q "Windows Setup"'
  check cleanup-root-size      bash -c '(( $(cat /sys/class/block/${1#/dev/}/size) >= $2 ))' _ "$root" "${old:-0}"
  check cleanup-btrfs-grown    bash -c 'dev=$(btrfs filesystem show --raw / | awk "/devid/ {print \$4; exit}"); part=$(( $(cat /sys/class/block/${1#/dev/}/size) * 512 )); (( part - dev < 64*1024*1024 ))' _ "$root"
  check cleanup-state-gone     bash -c '! sufun-windows-restore --status'
  say "INFO root now $(part_sectors "$root") sectors (before: $old)"
  rm -f "$PHASE"
  say "RESTORE-CLEANUP-DONE"
}

case "$MODE" in
  winsetup)
    # Started by the firmware entry "Windows Setup" (BootNext) from the WININSTALL
    # partition: only that partition's loader entry has this kernel option.
    say "WINSETUP-BOOT-OK"
    sleep 3; systemctl poweroff
    ;;
  live)
    say "BOOTED live"
    src=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null)
    say "INFO live medium: ${src:-?}"
    if [[ $src == /dev/mmcblk* ]] && [[ $(cat "/sys/block/$(lsblk -no PKNAME "$src")/device/type" 2>/dev/null) == SD ]]; then
      say "PASS live-from-sd"
    fi
    [[ $(grep -ow splash /proc/cmdline) ]] && say "INFO boot splash (Plymouth) requested on the kernel command line"
    welcome_shot     # first-start chooser (language, time zone, keyboard)
    if wait_for 1200 desktop_up sufun; then
      wait_for 240 first_login_done sufun
      sleep 30      # screenshots of the finished desktop
      check_image
      check_desktop sufun
      check_system
      check live-firewall-on bash -c 'ufw status | grep -q "Status: active"'
      security_live sufun
      host_portscan
      check_welcome sufun
      check_desktop_extras sufun
      ram_report sufun
      check_sensors sufun
      ram_details sufun
      installer_gui_test sufun
      check_firefox sufun
      memwatch_test sufun
      memory_pressure_test sufun
      check_firefox_disable sufun
      ram_details sufun
      say "LIVE-DESKTOP-OK"
    else
      say "LIVE-DESKTOP-TIMEOUT"
    fi
    ;;
  install|sdinstall)
    # install:   "내부 저장장치에 설치" (no disk given: the installer must pick the
    #            internal disk itself, not the SD card the test also attaches)
    # sdinstall: "SD카드에 설치" (live system runs from the card)
    say "BOOTED $MODE"
    [[ $MODE == sdinstall ]] && imode=sd || imode=emmc
    wait_for 600 nm-online -q -t 5
    wait_serial_getty
    if to_serial env SUFUN_AUTO=1 SUFUN_MODE=$imode SUFUN_HOST=sufun SUFUN_USER=tester \
       SUFUN_PASS=sufun-test SUFUN_TZ=Asia/Seoul SUFUN_LANG=2 \
       /usr/local/bin/sufun-install; then
      say "INSTALL-DONE"
    else
      say "INSTALL-FAILED"
    fi
    sleep 5; systemctl poweroff
    ;;
  installed)
    if [[ $(cat "$PHASE" 2>/dev/null) == cleanup ]]; then
      restore_cleanup; sleep 3; systemctl poweroff; exit 0
    fi
    say "BOOTED installed"
    say "VERSION $(pacman -Q sufun-base | awk '{print $2}' | sed 's/-[0-9]*$//')"
    if [[ -f /etc/sufun/boot-stage.conf ]]; then
      sd_checks
    else
      check boot-entry-sufun   grep -q '^title *SUFUN$' /boot/loader/entries/sufun.conf
      check emmc-root-internal bash -c 'r=$(findmnt -no SOURCE / | sed "s/\[.*//"); [[ $r == /dev/vda* ]]'
    fi
    check splash-option      grep -qw splash /proc/cmdline
    check plymouth-theme     bash -c '[[ $(plymouth-set-default-theme) == sufun ]]'
    check plymouth-initramfs bash -c 'lsinitcpio /boot/initramfs-linux-surface.img | grep -q "plymouth/themes/sufun/sufun.png"'
    check plymouth-logo      bash -c 'lsinitcpio /boot/initramfs-linux-surface.img | grep -q "plymouth/themes/sufun/logo.png"'
    check login-screen       wait_for 600 greeter_up
    check zram               bash -c 'swapon --show=NAME --noheadings | grep -q zram'
    check earlyoom           systemctl is-active earlyoom
    check firewall           systemctl is-active ufw
    check firewall-rules     bash -c 'ufw status | grep -q "Status: active"'
    check fstab-no-subvolid  bash -c '! grep -q subvolid /etc/fstab'
    check timeshift-config   test -f /etc/timeshift/timeshift.json
    check os-release         grep -q '^ID=sufun' /etc/os-release
    check_system
    security_accounts
    # The installer applied the live choice: the chooser must not run again
    check welcome-not-again  bash -c '[[ -f /var/lib/sufun/welcome-done ]] && ! pgrep -u sufun-oobe >/dev/null'
    if [[ -f /etc/sufun/boot-stage.conf ]]; then
      check rtc-local-time-sd grep -qx LOCAL /etc/adjtime      # Windows stays: clock in local time
    else
      check rtc-utc-emmc      grep -qx UTC /etc/adjtime
    fi
    sleep 20      # time for a screenshot of the login screen
    greeter_check
    # Test only: log the test user in automatically to check the Korean desktop.
    # (This file exists only on the CI test disk; a real install has no autologin.)
    mkdir -p /etc/sddm.conf.d
    printf '[Autologin]\nUser=tester\nSession=plasma\n' > /etc/sddm.conf.d/99-sufun-test-autologin.conf
    say "LOGIN-START"   # the CI script takes screenshots every 2 s now (login splash)
    systemctl restart sddm
    if wait_for 600 desktop_up tester; then
      wait_for 240 first_login_done tester
      sleep 30    # screenshots of the Korean desktop (clock: 오전/오후)
      check korean-language   grep -q '^LANG=ko_KR' /etc/locale.conf
      check korean-folders    test -d /home/tester/바탕화면 -a -d /home/tester/문서 -a -d /home/tester/다운로드
      check_desktop tester
      check_welcome tester
      check_desktop_extras tester
      check_sensors tester
      ram_details tester
      logout_screen tester
      security_installed tester
      host_portscan
    else
      say "FAIL desktop-login"
    fi
    # eMMC test only: the Windows restore test (needs the dummy ISO attached)
    [[ -f /etc/sufun/boot-stage.conf ]] || restore_prepare
    say "INSTALLED-DONE"
    systemctl poweroff
    ;;
esac
