# Fluent icon theme, standard (blue) color only.
# Same source and checksum as the AUR "fluent-icon-theme" package, but the AUR
# one installs all 9 color variants; we only need one.
pkgname=sufun-fluent-icons
pkgver=20260727
_tag=2026-07-27
pkgrel=1
pkgdesc="Fluent icon theme, standard color only (from vinceliuice/Fluent-icon-theme)"
arch=(any)
url=https://github.com/vinceliuice/Fluent-icon-theme
license=(GPL-3.0-only)
depends=(hicolor-icon-theme)
conflicts=(fluent-icon-theme fluent-icon-theme-git)
options=('!strip')
source=("${url}/archive/refs/tags/${_tag}.tar.gz")
b2sums=('db7107417d8424b4cbe345228ef1c127a4bbe3ef2ee568c25be52017f7d5561ad4494c78086ad5f098e075bc2021e3aae87350c4175e5874d080164eaeeb4a41')

prepare() {
  cd "Fluent-icon-theme-${_tag}"
  sed -i '/gtk-update-icon-cache/d' install.sh   # pacman's hook builds the cache
}

package() {
  cd "Fluent-icon-theme-${_tag}"
  install -d "$pkgdir/usr/share/icons"
  ./install.sh standard --dest "$pkgdir/usr/share/icons" --name Fluent
}
