# Local change: git+...#tag=v${pkgver} source (SKIP checksum) replaced by the
# GitLab tag tarball with a real checksum; git makedepend dropped.
makedepends=(python-build python-wheel python-installer python-setuptools)
source=("vkbasalt-cli-v${pkgver}.tar.gz::https://gitlab.com/TheEvilSkeleton/vkbasalt-cli/-/archive/v${pkgver}/vkbasalt-cli-v${pkgver}.tar.gz")
